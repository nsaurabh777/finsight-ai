# Copy to .env and fill in. .env is gitignored — never commit real keys.

# --- LLM provider selection -------------------------------------------------
# "groq"  -> free-tier hosted API, needs GROQ_API_KEY (get one free, no card:
#            https://console.groq.com/keys). Use this when you have no local GPU.
# "ollama" -> fully local, no key. Needs an Ollama server reachable at
#            OLLAMA_BASE_URL running the OLLAMA_MODEL below.
LLM_PROVIDER=groq

# --- Groq (only needed if LLM_PROVIDER=groq) ---
# Model name WITHOUT the "groq/" prefix (config.py adds it). llama-3.3-70b /
# llama-3.1-8b were deprecated for free tiers 2026-06-17; use a current model:
#   openai/gpt-oss-120b  (Groq's recommended 70B replacement)
#   openai/gpt-oss-20b   (smaller / faster)
#   qwen/qwen3.6-27b
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Free tier is 8000 tokens/min — a full crew run hits 429s. LiteLLM backs off
# and retries this many times before giving up; raise if runs still fail.
# LLM_NUM_RETRIES=6
# LLM_MAX_TOKENS=4096
# Cap the crew's request rate under Groq's 30 req/min free-tier ceiling.
# Ignored when LLM_PROVIDER=ollama (local, no rate limit).
# CREW_MAX_RPM=25

# --- Agent runtime limits (both providers) --------------------------------
# Tool-loop iterations per agent before it's forced to answer (CrewAI default
# is 25 — too high for small models that loop on a TICKER_NOT_FOUND result).
# AGENT_MAX_ITER=8
# Hard per-agent wall-clock ceiling in seconds. 0 = disabled (a legit local
# run on a small model can take 10+ min). Set e.g. 900 if an agent hangs, so
# the run aborts instead of stalling forever. First raise OLLAMA_CONTEXT_LENGTH
# below — a hang is usually CrewAI looping on context-window summarisation.
# AGENT_MAX_EXECUTION_TIME=0

# --- Ollama (only needed if LLM_PROVIDER=ollama) ---
# Point this at whichever machine runs Ollama. For a remote box use its LAN
# IP, e.g. http://192.168.1.50:11434
OLLAMA_BASE_URL=http://localhost:11434
# Pick a model that is genuinely good at tool/function calling — the crew makes
# many tool calls and a weak model loops or emits malformed calls. Recommended:
#   qwen2.5:7b        strong tool use, ~5GB, comfortable on a 16GB Mac
#   qwen2.5:14b       better reasoning, ~9GB, needs ~24GB unified memory
#   llama3.1:8b       ok fallback
OLLAMA_MODEL=qwen2.5:7b
#
# IMPORTANT: CrewAI's prompts (system prompt + tool schemas + history) are long
# and overflow Ollama's default 4096-token context — the server then truncates
# the instructions and the agents loop / error. Raise the server context before
# running:  OLLAMA_CONTEXT_LENGTH=16384 ollama serve
# (or set "Context length" in the Ollama Mac app settings, or bake it into a
#  Modelfile with `PARAMETER num_ctx 16384`).

# --- RAG retrieval (optional) --------------------------------------------
# Cosine similarity below which a news hit is treated as noise (not grounding)
# and retrieval reports "evidence unavailable" rather than handing the model
# an unrelated article to summarise. Raise if junk still leaks through.
# KNOWLEDGE_MIN_RELEVANCE=0.30

# --- Judge LLM for eval/ (optional) ---------------------------------------
# Defaults to the same provider/model as above. Override to judge with a
# different model than the one that generated the report (reduces self-bias).
# JUDGE_LLM_PROVIDER=groq

# --- Paths (optional; sensible defaults in src/config.py) ------------------
# CHROMA_PERSIST_DIR=data/chroma
# TICKER_DATA_CSV=data/tickers/nse_tickers.csv

# --- API server (optional) ------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000

# --- Automation delivery channels (Phase 5, optional) --------------------
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
