# Copy to automation/n8n/.env and fill in. This file is for the n8n container
# only — it is separate from the project root .env.

# Slack incoming webhook (https://api.slack.com/messaging/webhooks) — the one
# delivery channel wired up for now. Required.
SLACK_WEBHOOK_URL=

# Where n8n reaches the FinSight API. Default assumes `uvicorn src.api:app`
# runs on the host; override if the API is elsewhere.
FINSIGHT_API_URL=http://host.docker.internal:8000

# Daily-brief watchlist: newline- or comma-separated natural-language queries.
# Leave blank to use the workflow's built-in default list.
# FINSIGHT_WATCHLIST=Is KPIT Technologies a good stock to hold today?, Any notable movement in Reliance Industries?

# Cron + timestamp timezone for the schedule trigger.
GENERIC_TIMEZONE=Asia/Kolkata
