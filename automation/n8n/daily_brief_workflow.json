{
  "name": "FinSight Daily Brief",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            { "field": "cronExpression", "expression": "0 8 * * 1-5" }
          ]
        }
      },
      "name": "Weekday 8am Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "jsCode": "// Watchlist for the daily brief — edit this list.\nreturn [\n  { json: { query: 'Is KPIT Technologies a good stock to hold today?' } },\n  { json: { query: 'Any notable movement in Reliance Industries?' } }\n];"
      },
      "name": "Watchlist",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:8000/research",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"query\": $json.query } }}",
        "options": { "timeout": 300000 }
      },
      "name": "Call FinSight API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "jsCode": "return [{ json: { text: `*FinSight Daily Brief*\\n\\n${$json.report}` } }];"
      },
      "name": "Format for Slack",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.SLACK_WEBHOOK_URL}}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"text\": $json.text } }}"
      },
      "name": "Post to Slack",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1120, 300]
    }
  ],
  "connections": {
    "Weekday 8am Trigger": {
      "main": [[{ "node": "Watchlist", "type": "main", "index": 0 }]]
    },
    "Watchlist": {
      "main": [[{ "node": "Call FinSight API", "type": "main", "index": 0 }]]
    },
    "Call FinSight API": {
      "main": [[{ "node": "Format for Slack", "type": "main", "index": 0 }]]
    },
    "Format for Slack": {
      "main": [[{ "node": "Post to Slack", "type": "main", "index": 0 }]]
    }
  },
  "_comment_for_claude_code": "This is a hand-authored skeleton, not exported from a running n8n instance — node typeVersion numbers may be stale by the time you self-host n8n. Import this via the n8n UI ('Import from File') and let n8n itself flag/fix any version mismatches on nodes rather than trusting these numbers blindly. The Watchlist node's hardcoded queries should become editable (env var or a simple config file) once this moves past the prototype stage. Requires a SLACK_WEBHOOK_URL environment variable set in n8n's own environment (n8n Settings > Variables), separate from the project's .env."
}
